{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "afterMCPExecution": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10
      }
    ],
    "postToolUse": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10
      }
    ],
    "postToolUseFailure": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10
      }
    ],
    "preCompact": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "git -c alias.task-workspace-hook=!./src/nplet/adapters/launch.sh task-workspace-hook cursor --observe-read-content",
        "timeout": 10
      }
    ]
  }
}
